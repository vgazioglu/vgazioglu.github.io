---
import { siteData } from '../data/verbatimContent';

interface Props {
  lang: 'tr' | 'en';
}

const { lang } = Astro.props;
const data = siteData[lang];
---

<section id="about" class="py-12 md:py-20 relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Profile Picture (md: 5 cols) -->
      <div class="md:col-span-5 flex justify-center md:justify-start">
        <div class="relative w-full max-w-sm rounded-2xl overflow-hidden glass-panel border border-neutral-300/80 dark:border-zinc-800/90 shadow-xl">
          <div class="relative rounded-xl overflow-hidden aspect-[4/5] bg-neutral-200/40 dark:bg-zinc-950/80">
            <!-- Blurred Ambient Fill -->
            <img
              aria-hidden="true"
              src="/images/20210701_115414.jpg"
              alt=""
              class="absolute inset-0 w-full h-full object-cover filter blur-2xl opacity-40 dark:opacity-25 scale-125 select-none pointer-events-none"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent pointer-events-none z-10"></div>
            <!-- Main Portrait -->
            <img
              src="/images/20210701_115414.jpg"
              alt="Volkan Gazioğlu"
              class="relative z-10 w-full h-full object-cover object-center"
              loading="eager"
            />
          </div>
        </div>
      </div>

      <!-- Content (md: 7 cols) - Name, Quote, Divider, Bio -->
      <div class="md:col-span-7 flex flex-col space-y-6">
        
        <!-- Name -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
          {data.name}
        </h1>

        <!-- Quote -->
        <div class="space-y-2">
          <p class="font-serif italic text-base sm:text-lg text-zinc-700 dark:text-zinc-300 leading-relaxed">
            "{data.quote}"
          </p>
        </div>

        <!-- Divider Line -->
        <div class="w-full h-px bg-neutral-300 dark:bg-zinc-800"></div>

        <!-- Bio Paragraphs (Verbatim) -->
        <div class="space-y-4 text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed font-normal">
          {data.bio.map(paragraph => (
            <p>{paragraph}</p>
          ))}
        </div>

      </div>

    </div>
  </div>
</section>
