---
// Component: DynamicBackground.astro
// High-performance hardware-composited ambient gradient mesh.
// Zero continuous JavaScript loops, zero DOM churn, zero iGPU fill-rate bottlenecks.
---

<div class="ambient-mesh-viewport" aria-hidden="true">
  <div class="ambient-mesh-canvas">
    <!-- Fluid Color Orbs (Hardware-accelerated compositor layers) -->
    <div class="mesh-orb orb-gold"></div>
    <div class="mesh-orb orb-cyan"></div>
    <div class="mesh-orb orb-coral"></div>
    <div class="mesh-orb orb-purple"></div>
    <div class="mesh-orb orb-emerald"></div>
  </div>
</div>

<style>
  .ambient-mesh-viewport {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: var(--dynamic-bg-opacity, 0.45);
    transition: opacity 0.4s ease;
  }

  .ambient-mesh-canvas {
    position: absolute;
    inset: -15%;
    width: 130%;
    height: 130%;
    will-change: transform;
    transform: translate3d(0, 0, 0);
    animation: canvas-drift 60s ease-in-out infinite alternate;
  }

  .mesh-orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform;
    transform: translate3d(0, 0, 0);
    filter: blur(45px);
  }

  @media (min-width: 768px) {
    .mesh-orb {
      filter: blur(60px);
    }
  }

  /* Orb 1: Warm Champagne / Gold (intellige brand tone) */
  .orb-gold {
    top: 5%;
    right: 10%;
    width: 50vw;
    height: 50vw;
    max-width: 700px;
    max-height: 700px;
    background: radial-gradient(circle at center, rgba(224, 201, 166, 0.95) 0%, rgba(245, 158, 11, 0.65) 45%, transparent 72%);
    animation: float-orb-1 22s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }

  /* Orb 2: Vibrant Cyan / Aqua (Nagare signature tone) */
  .orb-cyan {
    top: 40%;
    left: -5%;
    width: 45vw;
    height: 45vw;
    max-width: 650px;
    max-height: 650px;
    background: radial-gradient(circle at center, rgba(100, 245, 237, 0.90) 0%, rgba(56, 189, 248, 0.60) 45%, transparent 72%);
    animation: float-orb-2 26s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }

  /* Orb 3: Coral / Sunset Glow */
  .orb-coral {
    bottom: 5%;
    right: 5%;
    width: 48vw;
    height: 48vw;
    max-width: 680px;
    max-height: 680px;
    background: radial-gradient(circle at center, rgba(255, 122, 89, 0.88) 0%, rgba(242, 100, 48, 0.55) 45%, transparent 72%);
    animation: float-orb-3 20s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }

  /* Orb 4: Deep Amethyst / Violet */
  .orb-purple {
    top: 15%;
    left: 20%;
    width: 42vw;
    height: 42vw;
    max-width: 600px;
    max-height: 600px;
    background: radial-gradient(circle at center, rgba(153, 107, 203, 0.85) 0%, rgba(139, 92, 246, 0.50) 45%, transparent 72%);
    animation: float-orb-4 28s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }

  /* Orb 5: Emerald / Mint Glow */
  .orb-emerald {
    bottom: 20%;
    left: 30%;
    width: 46vw;
    height: 46vw;
    max-width: 640px;
    max-height: 640px;
    background: radial-gradient(circle at center, rgba(50, 205, 50, 0.80) 0%, rgba(52, 211, 153, 0.50) 45%, transparent 72%);
    animation: float-orb-5 24s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }

  /* Asynchronous Hardware-composited Animations (0% CPU / <1% iGPU) */
  @keyframes float-orb-1 {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(-120px, 80px, 0) scale(1.12);
    }
    100% {
      transform: translate3d(60px, -70px, 0) scale(0.92);
    }
  }

  @keyframes float-orb-2 {
    0% {
      transform: translate3d(0, 0, 0) scale(0.95);
    }
    50% {
      transform: translate3d(140px, -90px, 0) scale(1.15);
    }
    100% {
      transform: translate3d(-50px, 80px, 0) scale(1.02);
    }
  }

  @keyframes float-orb-3 {
    0% {
      transform: translate3d(0, 0, 0) scale(1.08);
    }
    50% {
      transform: translate3d(-100px, -110px, 0) scale(0.94);
    }
    100% {
      transform: translate3d(80px, 60px, 0) scale(1.10);
    }
  }

  @keyframes float-orb-4 {
    0% {
      transform: translate3d(0, 0, 0) scale(0.92);
    }
    50% {
      transform: translate3d(90px, 120px, 0) scale(1.14);
    }
    100% {
      transform: translate3d(-110px, -50px, 0) scale(1.00);
    }
  }

  @keyframes float-orb-5 {
    0% {
      transform: translate3d(0, 0, 0) scale(1.05);
    }
    50% {
      transform: translate3d(-80px, -70px, 0) scale(0.90);
    }
    100% {
      transform: translate3d(100px, 90px, 0) scale(1.12);
    }
  }

  @keyframes canvas-drift {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    50% {
      transform: translate3d(2%, 2%, 0) rotate(2deg);
    }
    100% {
      transform: translate3d(-2%, -2%, 0) rotate(-2deg);
    }
  }
</style>
