---
import { siteConfig, translations } from '../data/i18n';

interface Props {
  lang: 'tr' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];
const currentPath = Astro.url.pathname;
const targetLangUrl = lang === 'tr' ? '/en' : '/';
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-[#fcfbf9]/85 dark:bg-[#121212]/85 border-b border-neutral-200/60 dark:border-white/10 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Name -->
    <a href={lang === 'tr' ? '/' : '/en'} class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-lg">
      <div class="relative w-9 h-9 rounded-full overflow-hidden ring-1 ring-brand-500/40 group-hover:ring-brand-500 transition-all">
        <img
          src="/images/kimlik32.png"
          alt="Volkan Gazioğlu"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
      <div class="flex flex-col">
        <span class="font-medium text-sm tracking-tight text-neutral-900 dark:text-neutral-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
          Volkan Gazioğlu
        </span>
        <span class="text-[11px] text-neutral-500 dark:text-neutral-400 font-mono">
          intellige.net
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-neutral-600 dark:text-neutral-300">
      <a href="#about" class="hover:text-neutral-900 dark:hover:text-white transition-colors">{lang === 'tr' ? 'Hakkında' : 'About'}</a>
      <a href="#timeline" class="hover:text-neutral-900 dark:hover:text-white transition-colors">{lang === 'tr' ? 'Kronoloji' : 'Timeline'}</a>
      <a href={`mailto:${siteConfig.email}`} class="hover:text-neutral-900 dark:hover:text-white transition-colors">{lang === 'tr' ? 'İletişim' : 'Contact'}</a>
    </nav>

    <!-- Controls (Social, Lang, Theme) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Social Quick Links -->
      <div class="hidden sm:flex items-center gap-1 text-neutral-500 dark:text-neutral-400">
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="p-2 rounded-lg hover:bg-neutral-200/50 dark:hover:bg-white/5 hover:text-neutral-900 dark:hover:text-white transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
        <a
          href={siteConfig.social.youtube}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
          class="p-2 rounded-lg hover:bg-neutral-200/50 dark:hover:bg-white/5 hover:text-neutral-900 dark:hover:text-white transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
        <a
          href={siteConfig.social.medium}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Medium"
          class="p-2 rounded-lg hover:bg-neutral-200/50 dark:hover:bg-white/5 hover:text-neutral-900 dark:hover:text-white transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
        </a>
      </div>

      <div class="h-4 w-px bg-neutral-300 dark:bg-white/10 hidden sm:block"></div>

      <!-- Language Toggle Button -->
      <a
        href={targetLangUrl}
        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/10 bg-neutral-100/60 dark:bg-neutral-900/60 text-xs font-semibold text-neutral-700 dark:text-neutral-300 hover:border-brand-500 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
        title={lang === 'tr' ? "Switch to English" : "Türkçe'ye Geç"}
      >
        <span class={lang === 'tr' ? "font-bold text-brand-600 dark:text-brand-400" : "opacity-60"}>TR</span>
        <span class="opacity-30">/</span>
        <span class={lang === 'en' ? "font-bold text-brand-600 dark:text-brand-400" : "opacity-60"}>EN</span>
      </a>

      <!-- Dark / Light Theme Toggle -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle Theme"
        class="p-2 rounded-lg border border-neutral-200/80 dark:border-white/10 bg-neutral-100/60 dark:bg-neutral-900/60 text-neutral-700 dark:text-neutral-300 hover:text-brand-600 dark:hover:text-brand-400 hover:border-brand-500 transition-colors"
      >
        <!-- Sun icon -->
        <svg id="theme-toggle-light-icon" class="hidden w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="5" stroke-width="2"></circle>
          <path stroke-linecap="round" stroke-width="2" d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
        <!-- Moon icon -->
        <svg id="theme-toggle-dark-icon" class="hidden w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle Menu"
        class="md:hidden p-2 rounded-lg border border-neutral-200/80 dark:border-white/10 text-neutral-700 dark:text-neutral-300"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-200/60 dark:border-white/10 bg-[#fcfbf9] dark:bg-[#121212] px-4 py-4 space-y-3">
    <a href="#about" class="block py-1.5 text-sm font-medium text-neutral-700 dark:text-neutral-300 hover:text-brand-500">{lang === 'tr' ? 'Hakkında' : 'About'}</a>
    <a href="#timeline" class="block py-1.5 text-sm font-medium text-neutral-700 dark:text-neutral-300 hover:text-brand-500">{lang === 'tr' ? 'Kronoloji' : 'Timeline'}</a>
    <a href={`mailto:${siteConfig.email}`} class="block py-1.5 text-sm font-medium text-neutral-700 dark:text-neutral-300 hover:text-brand-500">{lang === 'tr' ? 'İletişim' : 'Contact'}</a>
    <div class="pt-3 border-t border-neutral-200/60 dark:border-white/10 flex items-center gap-4">
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-xs text-neutral-600 dark:text-neutral-400">LinkedIn</a>
      <a href={siteConfig.social.youtube} target="_blank" rel="noopener noreferrer" class="text-xs text-neutral-600 dark:text-neutral-400">YouTube</a>
      <a href={siteConfig.social.medium} target="_blank" rel="noopener noreferrer" class="text-xs text-neutral-600 dark:text-neutral-400">Medium</a>
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="text-xs text-neutral-600 dark:text-neutral-400">GitHub</a>
    </div>
  </div>
</header>

<script is:inline>
  // Theme toggle script
  const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
  const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
  const themeToggleBtn = document.getElementById('theme-toggle');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function updateIcons(isDark) {
    if (isDark) {
      themeToggleLightIcon?.classList.remove('hidden');
      themeToggleDarkIcon?.classList.add('hidden');
    } else {
      themeToggleLightIcon?.classList.add('hidden');
      themeToggleDarkIcon?.classList.remove('hidden');
    }
  }

  const isDarkMode = document.documentElement.classList.contains('dark');
  updateIcons(isDarkMode);

  themeToggleBtn?.addEventListener('click', function() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateIcons(isDark);
  });

  mobileMenuBtn?.addEventListener('click', function() {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close mobile menu on anchor click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
    });
  });
</script>
