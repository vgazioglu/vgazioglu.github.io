---
import { siteData } from '../data/verbatimContent';

interface Props {
  lang: 'tr' | 'en';
}

const { lang } = Astro.props;
const data = siteData[lang];
---

<section id="timeline" class="py-12 sm:py-16 md:py-20 border-t border-neutral-200 dark:border-darkbg-border">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Milestones List -->
    <div class="space-y-12 sm:space-y-16">
      {data.milestones.map((m, index) => {
        const isEven = index % 2 === 1;

        return (
          <article class="glass-panel glass-panel-hover rounded-2xl p-5 sm:p-7 md:p-8 overflow-hidden">
            <div class={`grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-center ${isEven ? 'md:grid-flow-dense' : ''}`}>
              
              <!-- Media Column (md: 5 cols) -->
              <div class={`md:col-span-5 ${isEven ? 'md:col-start-8' : ''}`}>
                {m.image && (
                  <div
                    class="group relative rounded-xl overflow-hidden bg-neutral-100 dark:bg-darkbg-surface border border-neutral-200 dark:border-darkbg-border cursor-pointer shadow-sm hover:border-brand/50 transition-colors"
                    data-zoom-src={m.image}
                    data-zoom-title={m.title}
                    data-zoom-caption={m.desc}
                  >
                    <!-- Uniform fixed aspect ratio container -->
                    <div class="relative aspect-[4/3] w-full overflow-hidden flex items-center justify-center p-3 sm:p-4">
                      
                      <!-- Blurred Ambient Fill -->
                      <img
                        aria-hidden="true"
                        src={m.image}
                        alt=""
                        loading="lazy"
                        class="absolute inset-0 w-full h-full object-cover filter blur-2xl opacity-30 dark:opacity-20 scale-125 select-none pointer-events-none"
                      />

                      <!-- Centerpiece Document / Photo -->
                      <img
                        src={m.image}
                        alt={m.title}
                        loading="lazy"
                        class="relative z-10 max-h-full max-w-full object-contain rounded shadow-sm group-hover:scale-[1.02] transition-transform duration-200 dark:brightness-[0.98]"
                      />

                      <!-- Hover Zoom Prompt -->
                      <div class="absolute inset-0 z-20 bg-neutral-950/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-1.5 text-white text-xs font-medium backdrop-blur-[2px]">
                        <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                        </svg>
                        <span>{lang === 'tr' ? 'Büyüt' : 'Zoom'}</span>
                      </div>
                    </div>
                  </div>
                )}

                {m.video && (
                  <div class="rounded-xl overflow-hidden border border-neutral-200 dark:border-darkbg-border shadow-sm">
                    <div class="relative aspect-[4/3] w-full bg-neutral-950 flex items-center justify-center">
                      <iframe
                        src={m.video}
                        title={m.title}
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                        class="absolute inset-0 w-full h-full border-0"
                      ></iframe>
                    </div>
                  </div>
                )}
              </div>

              <!-- Text Content Column (md: 7 cols) -->
              <div class={`md:col-span-7 flex flex-col space-y-3 ${isEven ? 'md:col-start-1' : ''}`}>
                <div class="flex items-center gap-2.5">
                  <span class="text-xs font-mono font-bold text-brand-600 dark:text-brand">
                    #{String(m.id).padStart(2, '0')}
                  </span>
                  <div class="h-3 w-px bg-neutral-300 dark:bg-darkbg-border"></div>
                  <h2 class="text-xl sm:text-2xl md:text-3xl font-bold font-serif tracking-tight text-neutral-950 dark:text-neutral-50">
                    {m.title}
                  </h2>
                </div>

                <div class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed space-y-3 whitespace-pre-line font-normal">
                  {m.desc}
                </div>
              </div>

            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>
