---
import { timelineItems } from '../data/timeline';
import { translations } from '../data/i18n';

interface Props {
  lang: 'tr' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];

const categoryLabels = {
  network: lang === 'tr' ? 'İnternet & Ağ' : 'Internet & Network',
  telecom: lang === 'tr' ? 'Telekom & 5G' : 'Telecom & 5G',
  media: lang === 'tr' ? 'Açık Kaynak & Medya' : 'Open Source & Media',
  academy: lang === 'tr' ? 'Akademi & Güvenlik' : 'Academy & Defense',
};
---

<section id="timeline" class="py-16 md:py-24 relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center space-y-4 mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-neutral-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
        <span>1987 — {lang === 'tr' ? 'Günümüz' : 'Present'}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        {t.timeline.heading}
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl">
        {t.timeline.subheading}
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-4" id="timeline-filters">
        <button
          type="button"
          data-filter="all"
          class="timeline-filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 shadow-sm"
        >
          {t.timeline.filterAll}
        </button>
        <button
          type="button"
          data-filter="network"
          class="timeline-filter-btn px-4 py-2 rounded-xl text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 glass-panel glass-panel-hover"
        >
          {t.timeline.filterNetwork}
        </button>
        <button
          type="button"
          data-filter="telecom"
          class="timeline-filter-btn px-4 py-2 rounded-xl text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 glass-panel glass-panel-hover"
        >
          {t.timeline.filterTelecom}
        </button>
        <button
          type="button"
          data-filter="media"
          class="timeline-filter-btn px-4 py-2 rounded-xl text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 glass-panel glass-panel-hover"
        >
          {t.timeline.filterMedia}
        </button>
        <button
          type="button"
          data-filter="academy"
          class="timeline-filter-btn px-4 py-2 rounded-xl text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 glass-panel glass-panel-hover"
        >
          {t.timeline.filterAcademy}
        </button>
      </div>
    </div>

    <!-- Timeline Spine & Items -->
    <div class="relative mt-8">
      
      <!-- Vertical Continuous Line -->
      <div class="absolute left-4 sm:left-8 top-3 bottom-8 w-0.5 bg-neutral-200 dark:bg-zinc-800"></div>

      <!-- Items List -->
      <div class="space-y-12 sm:space-y-16" id="timeline-container">
        {timelineItems.map((item, index) => {
          const categoryName = categoryLabels[item.category];
          const title = item.title[lang];
          const desc = item.description[lang];
          const highlights = item.highlights ? item.highlights[lang] : [];

          return (
            <div
              class="timeline-item relative flex items-start gap-6 sm:gap-10 transition-all duration-300"
              data-category={item.category}
            >
              <!-- Timeline Node Marker -->
              <div class="relative z-10 flex-shrink-0 w-8 sm:w-16 flex items-center justify-center">
                <div class="w-8 h-8 rounded-full bg-white dark:bg-zinc-950 border-2 border-brand-500 shadow-sm flex items-center justify-center font-mono text-[11px] font-bold text-brand-600 dark:text-brand-400 ring-4 ring-neutral-50 dark:ring-zinc-950">
                  {String(item.id).padStart(2, '0')}
                </div>
              </div>

              <!-- Milestone Card -->
              <div class="flex-1 glass-panel glass-panel-hover rounded-2xl p-5 sm:p-7 overflow-hidden">
                
                <!-- Period & Category Header -->
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                  <div class="flex items-center gap-2">
                    <span class="inline-block px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-neutral-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-neutral-200 dark:border-zinc-700">
                      {item.period}
                    </span>
                    <span class="inline-block px-2 py-0.5 rounded text-[11px] font-medium bg-brand-500/10 text-brand-700 dark:text-brand-300 border border-brand-500/20">
                      {categoryName}
                    </span>
                  </div>

                  <span class="text-xs text-zinc-400 font-mono">
                    #{String(item.id).padStart(2, '0')} / 22
                  </span>
                </div>

                <!-- Milestone Title -->
                <h3 class="text-xl sm:text-2xl font-bold text-zinc-950 dark:text-zinc-50 mb-3 tracking-tight">
                  {title}
                </h3>

                <!-- Milestone Description -->
                <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4 whitespace-pre-line">
                  {desc}
                </p>

                <!-- Key Highlights Pills -->
                {highlights.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mb-5">
                    {highlights.map(hl => (
                      <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-neutral-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-neutral-200/80 dark:border-zinc-700/60">
                        <svg class="w-3 h-3 mr-1 text-brand-500" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                        </svg>
                        {hl}
                      </span>
                    ))}
                  </div>
                )}

                <!-- Media Preview (Image or Video) -->
                {item.image && (
                  <div class="mt-4 pt-4 border-t border-neutral-200/60 dark:border-zinc-800/60">
                    <div
                      class="group relative rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-900 border border-neutral-200 dark:border-zinc-800 cursor-pointer max-w-lg"
                      data-zoom-src={item.image}
                      data-zoom-title={title}
                      data-zoom-caption={desc}
                    >
                      <div class="aspect-[16/9] sm:aspect-[2/1] overflow-hidden flex items-center justify-center bg-zinc-900/10 dark:bg-black/40">
                        <img
                          src={item.image}
                          alt={title}
                          loading="lazy"
                          class="w-full h-full object-contain p-2 group-hover:scale-105 transition-transform duration-300"
                        />
                      </div>
                      
                      <!-- Overlay hover prompt -->
                      <div class="absolute inset-0 bg-zinc-950/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2 text-white font-medium text-xs backdrop-blur-xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                        </svg>
                        <span>{t.timeline.viewDoc}</span>
                      </div>
                    </div>
                  </div>
                )}

                {item.video && (
                  <div class="mt-4 pt-4 border-t border-neutral-200/60 dark:border-zinc-800/60">
                    <div class="relative rounded-xl overflow-hidden aspect-video bg-zinc-900 border border-neutral-200 dark:border-zinc-800 max-w-lg shadow-sm">
                      <iframe
                        src={item.video}
                        title={title}
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                        class="absolute inset-0 w-full h-full border-0"
                      ></iframe>
                    </div>
                  </div>
                )}

              </div>
            </div>
          );
        })}
      </div>

    </div>
  </div>
</section>

<script is:inline>
  // Category filtering script
  const filterButtons = document.querySelectorAll('.timeline-filter-btn');
  const timelineItemsList = document.querySelectorAll('.timeline-item');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update button styling
      filterButtons.forEach(b => {
        b.classList.remove('bg-zinc-900', 'text-white', 'dark:bg-zinc-100', 'dark:text-zinc-900', 'shadow-sm');
        b.classList.add('text-zinc-600', 'dark:text-zinc-400', 'glass-panel');
      });
      btn.classList.remove('text-zinc-600', 'dark:text-zinc-400', 'glass-panel');
      btn.classList.add('bg-zinc-900', 'text-white', 'dark:bg-zinc-100', 'dark:text-zinc-900', 'shadow-sm');

      // Filter timeline items
      timelineItemsList.forEach(item => {
        const itemCategory = item.getAttribute('data-category');
        if (filter === 'all' || itemCategory === filter) {
          item.style.display = 'flex';
          item.style.opacity = '1';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>
