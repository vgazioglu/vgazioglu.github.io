---
import { siteData } from '../data/verbatimContent';

interface Props {
  lang: 'tr' | 'en';
}

const { lang } = Astro.props;
const data = siteData[lang];
---

<section id="timeline" class="py-12 md:py-20 relative border-t border-neutral-200/80 dark:border-zinc-800/80">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Milestones List -->
    <div class="space-y-16 md:space-y-24">
      {data.milestones.map((m, index) => {
        const isEven = index % 2 === 1;

        return (
          <article class="glass-panel glass-panel-hover rounded-2xl p-6 sm:p-8 md:p-10 overflow-hidden">
            <div class={`grid grid-cols-1 md:grid-cols-12 gap-8 items-center ${isEven ? 'md:grid-flow-dense' : ''}`}>
              
              <!-- Media Column (md: 5 cols) -->
              <div class={`md:col-span-5 ${isEven ? 'md:col-start-8' : ''}`}>
                {m.image && (
                  <div
                    class="group relative rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-900 border border-neutral-200 dark:border-zinc-800 cursor-pointer shadow-sm"
                    data-zoom-src={m.image}
                    data-zoom-title={m.title}
                    data-zoom-caption={m.desc}
                  >
                    <div class="aspect-[4/3] flex items-center justify-center p-3 bg-white/50 dark:bg-zinc-950/50">
                      <img
                        src={m.image}
                        alt={m.title}
                        loading="lazy"
                        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                      />
                    </div>
                    <div class="absolute inset-0 bg-zinc-950/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2 text-white font-medium text-xs backdrop-blur-xs">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                      </svg>
                      <span>{lang === 'tr' ? 'Büyüt' : 'Zoom'}</span>
                    </div>
                  </div>
                )}

                {m.video && (
                  <div class="relative rounded-xl overflow-hidden aspect-video bg-zinc-950 border border-neutral-200 dark:border-zinc-800 shadow-sm">
                    <iframe
                      src={m.video}
                      title={m.title}
                      loading="lazy"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                      class="absolute inset-0 w-full h-full border-0"
                    ></iframe>
                  </div>
                )}
              </div>

              <!-- Text Content Column (md: 7 cols) -->
              <div class={`md:col-span-7 flex flex-col space-y-4 ${isEven ? 'md:col-start-1' : ''}`}>
                <div class="flex items-center gap-3">
                  <span class="text-xs font-mono font-semibold text-brand-600 dark:text-brand-400">
                    #{String(m.id).padStart(2, '0')}
                  </span>
                  <div class="h-3 w-px bg-neutral-300 dark:bg-zinc-700"></div>
                  <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
                    {m.title}
                  </h2>
                </div>

                <div class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed space-y-3 whitespace-pre-line">
                  {m.desc}
                </div>
              </div>

            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>
