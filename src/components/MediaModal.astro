---
---
<div
  id="media-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-zinc-950/80 backdrop-blur-md opacity-0 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-label="Media Preview"
>
  <div class="relative max-w-4xl w-full max-h-[90vh] flex flex-col items-center justify-center">
    <!-- Close Button -->
    <button
      id="modal-close-btn"
      type="button"
      class="absolute -top-12 right-0 p-2 text-zinc-400 hover:text-white rounded-full bg-zinc-900/60 hover:bg-zinc-800 transition-colors"
      aria-label="Kapat"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Image Container -->
    <div class="overflow-hidden rounded-2xl border border-zinc-800/80 bg-zinc-950 shadow-2xl flex flex-col">
      <img
        id="modal-image"
        src=""
        alt=""
        class="max-h-[75vh] w-auto object-contain mx-auto transition-transform"
      />
      <div id="modal-caption-container" class="p-5 bg-neutral-900/95 border-t border-white/10 text-left">
        <h4 id="modal-title" class="text-base sm:text-lg font-serif font-semibold text-neutral-100"></h4>
        <p id="modal-caption" class="text-sm sm:text-base font-serif text-neutral-300 mt-1.5 leading-relaxed line-clamp-3"></p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const modal = document.getElementById('media-modal');
  const modalImg = document.getElementById('modal-image');
  const modalTitle = document.getElementById('modal-title');
  const modalCaption = document.getElementById('modal-caption');
  const closeBtn = document.getElementById('modal-close-btn');

  function openModal(src, title, caption) {
    if (!modal || !modalImg) return;
    modalImg.src = src;
    modalImg.alt = title || 'Görsel';
    if (modalTitle) modalTitle.textContent = title || '';
    if (modalCaption) modalCaption.textContent = caption || '';

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      modal.classList.add('opacity-100');
    });
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0');
    setTimeout(() => {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
      if (modalImg) modalImg.src = '';
      document.body.style.overflow = '';
    }, 200);
  }

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // Attach click listeners to all media zoom triggers
  window.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-zoom-src]').forEach(el => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const src = el.getAttribute('data-zoom-src');
        const title = el.getAttribute('data-zoom-title') || '';
        const caption = el.getAttribute('data-zoom-caption') || '';
        if (src) openModal(src, title, caption);
      });
    });
  });
</script>
