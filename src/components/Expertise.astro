---
import { expertiseDomains } from '../data/timeline';
import { translations } from '../data/i18n';

interface Props {
  lang: 'tr' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];
---

<section id="expertise" class="py-16 md:py-24 relative bg-neutral-100/60 dark:bg-zinc-900/40 border-y border-neutral-200/80 dark:border-zinc-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center space-y-4 mb-14">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-700 dark:text-brand-300 border border-brand-500/20">
        Yetkinlik & Vizyon
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        {t.expertise.heading}
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl">
        {t.expertise.subheading}
      </p>
    </div>

    <!-- 4 Domains Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {expertiseDomains.map(domain => {
        const title = domain.title[lang];
        const desc = domain.description[lang];

        return (
          <div class="glass-panel glass-panel-hover rounded-2xl p-6 sm:p-8 flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20 flex items-center justify-center mb-5">
                {domain.icon === 'signal' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"></path>
                  </svg>
                )}
                {domain.icon === 'network' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                  </svg>
                )}
                {domain.icon === 'cpu' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path>
                  </svg>
                )}
                {domain.icon === 'terminal' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                )}
              </div>

              <h3 class="text-xl font-bold text-zinc-950 dark:text-zinc-50 mb-3">
                {title}
              </h3>

              <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
                {desc}
              </p>
            </div>

            <!-- Domain Tags -->
            <div class="flex flex-wrap gap-2 pt-4 border-t border-neutral-200/60 dark:border-zinc-800/60">
              {domain.tags.map(tag => (
                <span class="px-2.5 py-1 rounded-lg text-xs font-mono font-medium bg-neutral-200/50 dark:bg-zinc-800/60 text-zinc-700 dark:text-zinc-300">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
